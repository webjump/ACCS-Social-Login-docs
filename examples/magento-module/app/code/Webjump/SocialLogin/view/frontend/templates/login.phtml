/** @var \Webjump\SocialLogin\Block\Login $block */
/** @var \Magento\Framework\Escaper $escaper */

if (!$block->isEnabled() || !$block->hasEnabledProviders()) {
    return;
}

$position = $block->getPosition();
$containerId = 'webjump-social-login-widget-' . rand(1000, 9999);
?>

<div class="<?= $escaper->escapeHtmlAttr($block->getContainerCssClass()) ?>"
     data-position="<?= $escaper->escapeHtmlAttr($position) ?>">

    <?php if ($position === 'before_form'): ?>
        <div class="social-login-title">
            <h3><?= $escaper->escapeHtml(__('Login com suas Redes Sociais')) ?></h3>
        </div>
    <?php endif; ?>

    <?php if ($position !== 'replace_form'): ?>
        <div class="social-login-divider">
            <span><?= $escaper->escapeHtml(__('or continue with')) ?></span>
        </div>
    <?php endif; ?>

    <!-- Social Login Widget Container -->
    <div id="<?= $escaper->escapeHtmlAttr($containerId) ?>" class="social-login-widget-container"></div>

    <!-- Messages Container -->
    <div id="social-login-messages" class="social-login-messages"></div>

    <?php if ($position === 'after_form'): ?>
        <div class="social-login-footer">
            <p class="social-login-help">
                <?= $escaper->escapeHtml(__('Conecte-se facilmente usando suas contas existentes')) ?>
            </p>
        </div>
    <?php endif; ?>

</div>

<!-- Load Social Login Widget Script -->
<script>
require(['jquery', 'domReady!'], function($) {
    'use strict';

    // Widget configuration from Adobe Commerce admin
    var widgetConfig = <?= /* @noEscape */ $block->getWidgetConfigJson() ?>;
    widgetConfig.containerId = '<?= $escaper->escapeJs($containerId) ?>';

    // Enhanced success callback with Commerce integration
    widgetConfig.onSuccess = function(data) {
        console.log('Social login successful:', data);

        // Safe provider name extraction with defensive programming
        var provider = data.socialProvider || data.provider || 'Social Provider';
        var providerName = typeof provider === 'string'
            ? provider.charAt(0).toUpperCase() + provider.slice(1)
            : 'Social Provider';

        showMessage('✅ Signed in successfully with ' + providerName + '!', 'success');

        // Store token if available
        if (data.token) {
            sessionStorage.setItem('customer_token', data.token);
        }

        // Redirect based on configuration or default
        var redirectUrl = widgetConfig.redirectUrl || '<?= $escaper->escapeJs($block->getUrl('customer/account/')) ?>';

        setTimeout(function() {
            window.location.href = redirectUrl;
        }, 1500);
    };

    // Enhanced error callback
    widgetConfig.onError = function(error) {
        console.error('Social login failed:', error);

        var errorMessages = {
            'network_error': '<?= $escaper->escapeJs(__('Connection error. Please check your internet connection.')) ?>',
            'auth_cancelled': '<?= $escaper->escapeJs(__('Login cancelled.')) ?>',
            'invalid_credentials': '<?= $escaper->escapeJs(__('Invalid credentials. Please try again.')) ?>',
            'server_error': '<?= $escaper->escapeJs(__('Server error. Please try again later.')) ?>'
        };

        var userMessage = errorMessages[error.code] || error.message;
        showMessage('❌ ' + userMessage, 'error');
    };

    // Load widget using enhanced loader from Helper
    <?= /* @noEscape */ $block->getSocialLoginHelper()->getWidgetLoaderScript() ?>

    // Initialize widget with config
    loadSocialLoginWidget(widgetConfig);

    // Helper function to show messages
    function showMessage(text, type) {
        var messagesContainer = document.getElementById('social-login-messages');
        if (!messagesContainer) return;

        var messageDiv = document.createElement('div');
        messageDiv.className = 'message ' + type;
        messageDiv.innerHTML = '<div>' + text + '</div>';

        messagesContainer.innerHTML = '';
        messagesContainer.appendChild(messageDiv);

        // Auto-remove after 5 seconds
        setTimeout(function() {
            if (messageDiv.parentNode) {
                messageDiv.remove();
            }
        }, 5000);
    }
});
</script>

